<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F0F4F8">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">

        <Label 
            Text="Cálculo da Diária"
            FontSize="42"
            FontFamily="OpenSans-Semibold"
            TextColor="#1B4F72"
            HorizontalOptions="Center"
            Margin="0,10,0,5" />

        <Frame Padding="15"
               CornerRadius="20"
               BorderColor="#A9CCE3">

            <VerticalStackLayout Spacing="15">

                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <!-- Adultos -->
                    <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" TextColor="#2C3E50" />
                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="#1B4F72"
                           FontAttributes="Bold"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}" />
                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0" Maximum="10" Increment="1" />

                    <!-- Crianças -->
                    <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" TextColor="#2C3E50" />
                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="#1B4F72"
                           FontAttributes="Bold"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}" />
                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0" Maximum="10" Increment="1" />

                </Grid>

                <BoxView HeightRequest="1" Color="#A9CCE3" />

                <!-- Picker -->
                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação"
                        ItemDisplayBinding="{Binding Descricao}"
                        TextColor="#1B4F72" />

                <BoxView HeightRequest="1" Color="#A9CCE3" />

                <!-- Datas -->
                <Label Text="Período da Estadia"
                       FontAttributes="Bold"
                       TextColor="#2C3E50" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Check-in:" TextColor="#2C3E50" />
                    <DatePicker x:Name="dtpck_checkin"
                                DateSelected="dtpck_checkin_DateSelected"
                                Format="dd/MM/yyyy"
                                TextColor="#1B4F72" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Check-out:" TextColor="#2C3E50" />
                    <DatePicker x:Name="dtpck_checkout"
                                Format="dd/MM/yyyy"
                                TextColor="#1B4F72" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#A9CCE3" />

                <!-- Botão Avançar -->
                <Button Text="Avançar"
                        Clicked="BtnAvancar_Clicked"
                        BackgroundColor="#1B4F72"
                        TextColor="White"
                        CornerRadius="15" />

                <!-- Botão Contato -->
                <Button Text="Contato / Suporte"
                        Clicked="BtnContato_Clicked"
                        BackgroundColor="#2E8B57"
                        TextColor="White"
                        CornerRadius="15" />

                <!-- Botão Sobre -->
                <Button Text="Sobre"
                        Clicked="ButtonSobre_Clicked"
                        BackgroundColor="#2D6DA8"
                        TextColor="White"
                        CornerRadius="15" />

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>

</ContentPage>
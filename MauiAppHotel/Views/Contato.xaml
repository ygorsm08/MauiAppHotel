<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Contato"
             Title="Contato"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Contato / Suporte"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1B4F72"
                   HorizontalOptions="Center" />

            <Frame CornerRadius="15" Padding="15" BorderColor="#A9CCE3">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Telefone" FontAttributes="Bold" TextColor="#1B4F72" />
                    <Label Text="(11) 3456-7890" TextColor="#2C3E50" />

                    <BoxView HeightRequest="1" Color="#D0D0D0" />

                    <Label Text="E-mail" FontAttributes="Bold" TextColor="#1B4F72" />
                    <Label Text="contato@hotelparadise.com.br" TextColor="#2C3E50" />

                    <BoxView HeightRequest="1" Color="#D0D0D0" />

                    <Label Text="Endereço" FontAttributes="Bold" TextColor="#1B4F72" />
                    <Label Text="Av. das Palmeiras, 500 — São Paulo/SP" TextColor="#2C3E50" />

                    <BoxView HeightRequest="1" Color="#D0D0D0" />

                    <Label Text="Horário de Atendimento" FontAttributes="Bold" TextColor="#1B4F72" />
                    <Label Text="Seg a Sex: 08h às 18h | Sáb: 09h às 14h" TextColor="#2C3E50" />

                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar"
                    Clicked="BtnVoltar_Clicked"
                    BackgroundColor="#2D6DA8"
                    TextColor="White"
                    CornerRadius="15" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>